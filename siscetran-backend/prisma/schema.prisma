generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                String         @id @default(cuid())
  email             String         @unique
  senha             String
  role              Role           @default(USUARIO)
  setor             String?
  ativo             Boolean        @default(true)
  ultimaTrocaSenha  DateTime       @default(now())
  resetToken        String?        @unique
  resetTokenExpiry  DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  logs              Log[]
  matrizesAvaliadas Matriz[]       @relation("Avaliador")
  matrizesCriadas   Matriz[]       @relation("Criador")
  votos             Voto[]
  revisoesCriadas   MatrizRevisao[]
}

model MatrizRevisao {
  id          String   @id @default(cuid())
  matrizId    String
  numero      Int
  criadoEm    DateTime @default(now())
  criadoPorId String?
  observacao  String?
  matriz      Matriz   @relation(fields: [matrizId], references: [id], onDelete: Cascade)
  criadoPor   Usuario? @relation(fields: [criadoPorId], references: [id])
  votos       Voto[]

  @@unique([matrizId, numero])
  @@index([matrizId])
  @@index([criadoPorId])
}

model Voto {
  id         String   @id @default(cuid())
  matrizId   String
  revisaoId  String
  usuarioId  String
  voto       TipoVoto
  comentario String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  matriz     Matriz   @relation(fields: [matrizId], references: [id], onDelete: Cascade)
  revisao    MatrizRevisao @relation(fields: [revisaoId], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([revisaoId, usuarioId])
  @@index([matrizId])
  @@index([revisaoId])
  @@index([usuarioId])
}

model Matriz {
  id               String        @id
  nome             String
  oque             String
  porque           String
  como             String
  quando           String
  onde             String
  quanto           String
  impacto          Impacto       @default(MEDIO)
  observacao       String?
  percentual       Int           @default(0)
  status           Status        @default(RASCUNHO)
  comentarioComite String?
  criadoPorId      String
  avaliadoPorId    String?
  dataCriacao      DateTime      @default(now())
  dataAvaliacao    DateTime?
  updatedAt        DateTime      @updatedAt
  acoes            AcoesMatriz[]
  avaliadoPor      Usuario?      @relation("Avaliador", fields: [avaliadoPorId], references: [id])
  criadoPor        Usuario       @relation("Criador", fields: [criadoPorId], references: [id])
  votos            Voto[]
  revisoes         MatrizRevisao[]
}

model AcoesMatriz {
  id       String @id @default(cuid())
  matrizId String
  acaoId   String
  etapas   Json   @default("[]")
  acao     Acao   @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  matriz   Matriz @relation(fields: [matrizId], references: [id], onDelete: Cascade)

  @@unique([matrizId, acaoId])
}

model Acao {
  id               String        @id
  og               String?
  lae              String?
  diretriz         String
  prazo            Prazo
  setor            String?
  meta             String
  indicador        String
  restricoes       String?
  linhaPlanilha    Int
  responsavel      String?
  dadosIncompletos String[]
  projetoCodigo    String?
  projetoNome      String?
  projetoTema      String?
  matrizes         AcoesMatriz[]
}

model Log {
  id        String   @id @default(cuid())
  usuarioId String
  acao      String
  detalhes  String?
  ip        String?
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
}

enum Role {
  USUARIO
  COMITE
  ADMIN_SETOR
  ADMIN_GERAL
}

enum TipoVoto {
  APROVAR
  REJEITAR
}

enum Status {
  RASCUNHO
  ENVIADO
  APROVADO
  PENDENTE
}

enum Impacto {
  BAIXO
  MEDIO
  ALTO
}

enum Prazo {
  CURTO_PRAZO
  MEDIO_PRAZO
  LONGO_PRAZO
}
