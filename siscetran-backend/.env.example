# Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/siscetran"

# JWT
JWT_SECRET="siscetran-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Segurança
BCRYPT_SALT_ROUNDS=10

# URL do frontend (usada no link do e-mail de criação/redefinição de senha)
FRONTEND_URL="http://localhost:5173"

# E-mail (remetente: radar2030cetranpa@gmail.com)
# MAIL_PROVIDER: console (só dev, não envia) | smtp | gmail_api
MAIL_PROVIDER=console
MAIL_FROM_ADDRESS="radar2030cetranpa@gmail.com"
MAIL_FROM_NAME="Radar 2030 - CETRAN/PA"

# MAIL_PROVIDER=smtp  (Gmail com Senha de app; NÃO funciona no Render free)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER="radar2030cetranpa@gmail.com"
SMTP_PASS=""

# MAIL_PROVIDER=gmail_api  (HTTPS; funciona no Render free)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
